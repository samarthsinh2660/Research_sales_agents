OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=true
# Set to your workspace's regional endpoint if applicable, e.g. https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# --- sales_outreach app ---
# Serper API Key for using Serper search
SERPER_API_KEY=

# RapidAPI Key for accessing LinkedIn scraper API
RAPIDAPI_KEY=

# Airtable API configuration (lead source for sales_outreach)
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# HubSpot private app token (PAT), alternative lead source
HUBSPOT_API_KEY=

# Google Sheet id (extracted from its URL), alternative lead source
SHEET_ID=
